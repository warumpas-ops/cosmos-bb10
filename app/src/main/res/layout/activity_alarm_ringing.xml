<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ringRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/bg"
    android:padding="20dp">

    <!-- Top Pixel Moon -->
    <com.cosmos.app.PixelMoonView
        android:id="@+id/moonView"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Big Ringing Time -->
    <TextView
        android:id="@+id/tvAlarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:00 AM"
        android:textColor="@color/text_primary"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlarmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ Morning Alarm ]"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- Mission Card Box -->
    <LinearLayout
        android:id="@+id/missionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvMissionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MISSION: MATH (1 / 3)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvProblem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24 + 37 = [ ? ]"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/input_bg"
            android:textColor="@color/text_primary"
            android:hint="type answer &amp; press Enter"
            android:textColorHint="@color/text_secondary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="[ SUBMIT ]"
            android:textColor="@color/text_primary"
            android:background="@color/divider"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Emergency Dismiss Button -->
    <Button
        android:id="@+id/btnEmergency"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="[ emergency dismiss (hold 3s) ]"
        android:textColor="@color/text_secondary"
        android:background="@null"
        android:textSize="11sp" />

</LinearLayout>

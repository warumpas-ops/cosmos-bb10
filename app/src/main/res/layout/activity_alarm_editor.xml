<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/header_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="CANCEL"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="SET ALARM"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="SAVE"
            android:textColor="@color/bg"
            android:background="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Content Form in ScrollView for 720x720 Square Screen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Time Picker -->
            <TimePicker
                android:id="@+id/timePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp" />

            <!-- Alarm Label Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALARM LABEL:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etLabel"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/input_bg"
                android:textColor="@color/text_primary"
                android:hint="Alarm Label"
                android:textColorHint="@color/text_secondary"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

            <!-- Repeat Days -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPEAT DAYS:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button android:id="@+id/btnDaySun" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="S" android:textSize="12sp" android:layout_marginRight="2dp"/>
                <Button android:id="@+id/btnDayMon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="M" android:textSize="12sp" android:layout_marginRight="2dp"/>
                <Button android:id="@+id/btnDayTue" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="T" android:textSize="12sp" android:layout_marginRight="2dp"/>
                <Button android:id="@+id/btnDayWed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="W" android:textSize="12sp" android:layout_marginRight="2dp"/>
                <Button android:id="@+id/btnDayThu" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="T" android:textSize="12sp" android:layout_marginRight="2dp"/>
                <Button android:id="@+id/btnDayFri" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F" android:textSize="12sp" android:layout_marginRight="2dp"/>
                <Button android:id="@+id/btnDaySat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="S" android:textSize="12sp"/>
            </LinearLayout>

            <!-- Loud Alarm Sounds Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOUD ALARM SOUND:"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTestSound"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="[ ▶ TEST ]"
                    android:textSize="10sp"
                    android:textColor="@color/text_primary"
                    android:background="@color/divider"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button android:id="@+id/btnSoundDigital" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Digital" android:textSize="11sp" android:layout_marginRight="3dp"/>
                <Button android:id="@+id/btnSoundSiren" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Siren" android:textSize="11sp" android:layout_marginRight="3dp"/>
                <Button android:id="@+id/btnSoundReveille" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Reveille" android:textSize="11sp" android:layout_marginRight="3dp"/>
                <Button android:id="@+id/btnSoundBuzzer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Buzzer" android:textSize="11sp"/>
            </LinearLayout>

            <!-- Mission Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAKE-UP MISSION:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button android:id="@+id/btnMissionMath" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="[ Math ]" android:textSize="11sp" android:layout_marginRight="3dp"/>
                <Button android:id="@+id/btnMissionShake" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="[ Shake ]" android:textSize="11sp" android:layout_marginRight="3dp"/>
                <Button android:id="@+id/btnMissionTyping" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="[ Type ]" android:textSize="11sp" android:layout_marginRight="3dp"/>
                <Button android:id="@+id/btnMissionNormal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="[ Standard ]" android:textSize="11sp"/>
            </LinearLayout>

            <!-- Mission Parameters (Count) -->
            <LinearLayout
                android:id="@+id/countContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvCountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROBLEMS COUNT:"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btnCount1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="[ 1x ]" android:textSize="11sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btnCount3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="[ 3x ]" android:textSize="11sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btnCount5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="[ 5x ]" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Delete Button -->
            <Button
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="[ DELETE ALARM ]"
                android:textColor="#FF5555"
                android:background="@color/surface"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
